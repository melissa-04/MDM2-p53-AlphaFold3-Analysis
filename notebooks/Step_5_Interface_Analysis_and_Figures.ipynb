# ============================================================================
# ADIM 5: Interface Analizi + Profesyonel Grafikler
# AlphaFold kompleks modelinde temas eden residüleri bul, kristal yapıyla karşılaştır
# ============================================================================

import os
import glob
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Patch
from Bio.PDB import PDBParser

work_dir = '/content/drive/My Drive/MDM2_p53_Project'
af_dir   = f'{work_dir}/results/alphafold_predictions'
fig_dir  = f'{work_dir}/results/figures'
int_dir  = f'{work_dir}/results/interface_analysis'
os.makedirs(fig_dir, exist_ok=True)
os.makedirs(int_dir, exist_ok=True)

# Grafik stili
plt.rcParams['figure.dpi'] = 130
plt.rcParams['font.size'] = 11
plt.rcParams['axes.grid'] = True
plt.rcParams['grid.alpha'] = 0.3

print("=" * 70)
print("ADIM 5: INTERFACE ANALİZİ (AlphaFold Kompleks Modeli)")
print("=" * 70)

# ----------------------------------------------------------------------------
# 5.1 AlphaFold kompleks PDB'sini bul (rank_001 = en iyi model)
# ----------------------------------------------------------------------------

complex_pdbs = glob.glob(f'{af_dir}/mdm2_p53_complex/**/*unrelaxed_rank_001*.pdb', recursive=True)
complex_pdb = complex_pdbs[0]
print(f"\nKompleks model: {os.path.basename(complex_pdb)}")

# ----------------------------------------------------------------------------
# 5.2 Interface residülerini bul
#   ColabFold multimer çıktısında zincirler: A = MDM2, B = p53
# ----------------------------------------------------------------------------

parser = PDBParser(QUIET=True)
structure = parser.get_structure('complex', complex_pdb)
model = structure[0]

# Üç harfli -> tek harf
aa3to1 = {
    'ALA':'A','ARG':'R','ASN':'N','ASP':'D','CYS':'C','GLN':'Q','GLU':'E',
    'GLY':'G','HIS':'H','ILE':'I','LEU':'L','LYS':'K','MET':'M','PHE':'F',
    'PRO':'P','SER':'S','THR':'T','TRP':'W','TYR':'Y','VAL':'V'
}

def get_atoms(chain_id):
    atoms = []
    if chain_id in model:
        for res in model[chain_id]:
            if res.id[0] == ' ':
                for atom in res:
                    atoms.append((atom, res.id[1], res.resname))
    return atoms

CUTOFF = 5.0  # Angstrom
atoms_A = get_atoms('A')  # MDM2
atoms_B = get_atoms('B')  # p53

print(f"MDM2 (zincir A): {len(set(a[1] for a in atoms_A))} residü")
print(f"p53  (zincir B): {len(set(a[1] for a in atoms_B))} residü")

# Temas eden residüleri ve kontakt sayılarını bul
interface_A = {}  # res_id -> (resname, contact_count)
interface_B = {}

for atom_a, rid_a, rn_a in atoms_A:
    for atom_b, rid_b, rn_b in atoms_B:
        if atom_a - atom_b < CUTOFF:
            interface_A[rid_a] = (rn_a, interface_A.get(rid_a, (rn_a, 0))[1] + 1)
            interface_B[rid_b] = (rn_b, interface_B.get(rid_b, (rn_b, 0))[1] + 1)

print(f"\nInterface'de MDM2 residüleri: {len(interface_A)}")
print(f"Interface'de p53 residüleri:  {len(interface_B)}")

# ----------------------------------------------------------------------------
# 5.3 Kritik triad kontrolü (Phe19, Trp23, Leu26)
#   p53 sekansı 1'den başlıyor (MEEPQ...), yani residü numaraları UniProt ile aynı
# ----------------------------------------------------------------------------

triad = {19: 'PHE', 23: 'TRP', 26: 'LEU'}

print("\n" + "=" * 70)
print("KRİTİK TRIAD KONTROLÜ (AlphaFold modelinde)")
print("=" * 70)

triad_results = {}
for pos, expected in triad.items():
    if pos in interface_B:
        resname, contacts = interface_B[pos]
        in_interface = True
        triad_results[pos] = (resname, contacts, True)
        print(f"  p53 {expected}{pos}: interface'de VAR ({contacts} kontakt)")
    else:
        triad_results[pos] = (expected, 0, False)
        print(f"  p53 {expected}{pos}: interface'de YOK")

# ----------------------------------------------------------------------------
# 5.4 GRAFİK 1: Skor karşılaştırma (bar chart)
# ----------------------------------------------------------------------------

print("\n" + "=" * 70)
print("GRAFİKLER OLUŞTURULUYOR")
print("=" * 70)

labels = ['MDM2\n(monomer)', 'p53\n(monomer)', 'MDM2-p53\n(kompleks)']
plddt_vals = [82.7, 65.6, 66.6]
ptm_vals   = [0.680, 0.230, 0.570]
iptm_vals  = [0, 0, 0.690]

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5))

# pLDDT
colors_plddt = ['#2c7fb8' if v >= 70 else '#fdae61' for v in plddt_vals]
bars1 = ax1.bar(labels, plddt_vals, color=colors_plddt, edgecolor='black', linewidth=0.8)
ax1.axhline(70, color='green', linestyle='--', alpha=0.7, label='Güvenilir eşik (70)')
ax1.set_ylabel('pLDDT (ortalama)')
ax1.set_title('Yapı Güven Skoru (pLDDT)', fontweight='bold')
ax1.set_ylim(0, 100)
ax1.legend()
for bar, v in zip(bars1, plddt_vals):
    ax1.text(bar.get_x() + bar.get_width()/2, v + 1.5, f'{v:.1f}',
             ha='center', fontweight='bold')

# pTM / ipTM
x = np.arange(len(labels))
w = 0.35
bars2 = ax2.bar(x - w/2, ptm_vals, w, label='pTM', color='#7570b3', edgecolor='black')
bars3 = ax2.bar(x + w/2, iptm_vals, w, label='ipTM (etkileşim)', color='#d95f02', edgecolor='black')
ax2.axhline(0.6, color='green', linestyle='--', alpha=0.7, label='Etkileşim eşik (0.6)')
ax2.set_ylabel('Skor')
ax2.set_title('Topoloji ve Etkileşim Güveni', fontweight='bold')
ax2.set_xticks(x)
ax2.set_xticklabels(labels)
ax2.set_ylim(0, 1)
ax2.legend(fontsize=9)
for bar, v in zip(bars3, iptm_vals):
    if v > 0:
        ax2.text(bar.get_x() + bar.get_width()/2, v + 0.02, f'{v:.3f}',
                 ha='center', fontweight='bold', color='#d95f02')

plt.tight_layout()
plt.savefig(f'{fig_dir}/01_score_comparison.png', bbox_inches='tight')
plt.show()
print("  01_score_comparison.png kaydedildi")

# ----------------------------------------------------------------------------
# 5.5 GRAFİK 2: p53 interface residü kontakt haritası
# ----------------------------------------------------------------------------

fig, ax = plt.subplots(figsize=(11, 5))

p53_res = sorted(interface_B.keys())
contacts = [interface_B[r][1] for r in p53_res]
res_labels = [f"{aa3to1.get(interface_B[r][0], '?')}{r}" for r in p53_res]

# Triad residülerini farklı renkle vurgula
bar_colors = ['#d62728' if r in triad else '#1f77b4' for r in p53_res]

bars = ax.bar(range(len(p53_res)), contacts, color=bar_colors, edgecolor='black', linewidth=0.7)
ax.set_xticks(range(len(p53_res)))
ax.set_xticklabels(res_labels, rotation=45, ha='right')
ax.set_ylabel('Atomik kontakt sayısı')
ax.set_xlabel('p53 residüsü')
ax.set_title('p53 Interface Residüleri — MDM2 ile Atomik Kontaktlar\n(Kırmızı = kritik triad: Phe19, Trp23, Leu26)',
             fontweight='bold')

legend_elements = [
    Patch(facecolor='#d62728', edgecolor='black', label='Kritik triad'),
    Patch(facecolor='#1f77b4', edgecolor='black', label='Diğer interface residüleri')
]
ax.legend(handles=legend_elements)

plt.tight_layout()
plt.savefig(f'{fig_dir}/02_p53_interface_contacts.png', bbox_inches='tight')
plt.show()
print("  02_p53_interface_contacts.png kaydedildi")

# ----------------------------------------------------------------------------
# 5.6 GRAFİK 3: Triad doğrulama özeti
# ----------------------------------------------------------------------------

fig, ax = plt.subplots(figsize=(8, 5))

triad_labels = [f'{v}{k}' for k, v in [(19,'Phe'), (23,'Trp'), (26,'Leu')]]
triad_contacts = [triad_results[p][1] for p in [19, 23, 26]]
triad_colors = ['#2ca02c' if triad_results[p][2] else '#d62728' for p in [19, 23, 26]]

bars = ax.bar(triad_labels, triad_contacts, color=triad_colors, edgecolor='black', linewidth=1)
ax.set_ylabel('Atomik kontakt sayısı')
ax.set_title('Kritik Triad Doğrulaması\nAlphaFold modeli kristal yapıyla uyumlu mu?',
             fontweight='bold')
for bar, p in zip(bars, [19, 23, 26]):
    c = triad_results[p][1]
    ax.text(bar.get_x() + bar.get_width()/2, c + 0.5, f'{c} kontakt',
            ha='center', fontweight='bold')

plt.tight_layout()
plt.savefig(f'{fig_dir}/03_triad_validation.png', bbox_inches='tight')
plt.show()
print("  03_triad_validation.png kaydedildi")

# ----------------------------------------------------------------------------
# 5.7 Sonuçları TXT olarak kaydet
# ----------------------------------------------------------------------------

txt_file = f'{int_dir}/interface_analysis_report.txt'
with open(txt_file, 'w') as f:
    f.write("INTERFACE ANALİZİ RAPORU\n")
    f.write("AlphaFold2-Multimer Kompleks Modeli\n")
    f.write("=" * 70 + "\n\n")
    f.write(f"Analiz edilen model: {os.path.basename(complex_pdb)}\n")
    f.write(f"Kontakt mesafe eşiği: {CUTOFF} Angstrom\n\n")
    
    f.write("INTERFACE BÜYÜKLÜĞÜ\n")
    f.write("-" * 70 + "\n")
    f.write(f"MDM2 (zincir A) interface residü sayısı: {len(interface_A)}\n")
    f.write(f"p53  (zincir B) interface residü sayısı: {len(interface_B)}\n\n")
    
    f.write("p53 INTERFACE RESIDÜLERİ (kontakt sayısı ile)\n")
    f.write("-" * 70 + "\n")
    for r in sorted(interface_B.keys()):
        rn, c = interface_B[r]
        mark = "  <-- KRİTİK TRIAD" if r in triad else ""
        f.write(f"  {aa3to1.get(rn,'?')}{r} ({rn}): {c} kontakt{mark}\n")
    
    f.write("\nMDM2 INTERFACE RESIDÜLERİ (kontakt sayısı ile)\n")
    f.write("-" * 70 + "\n")
    for r in sorted(interface_A.keys()):
        rn, c = interface_A[r]
        f.write(f"  {aa3to1.get(rn,'?')}{r} ({rn}): {c} kontakt\n")
    
    f.write("\nKRİTİK TRIAD DOĞRULAMASI\n")
    f.write("-" * 70 + "\n")
    for pos, expected in triad.items():
        rn, c, found = triad_results[pos]
        status = f"interface'de VAR ({c} kontakt)" if found else "interface'de YOK"
        f.write(f"  p53 {expected}{pos}: {status}\n")
    
    all_found = all(triad_results[p][2] for p in triad)
    f.write("\nSONUÇ\n")
    f.write("-" * 70 + "\n")
    if all_found:
        f.write("AlphaFold modeli, kristal yapıda bilinen kritik triad\n")
        f.write("(Phe19, Trp23, Leu26) residülerinin tamamını interface'de\n")
        f.write("doğru şekilde öngörmüştür. Model biyolojik olarak tutarlıdır.\n")
    else:
        f.write("Triad residülerinin bir kısmı interface'de bulunamadı.\n")

print(f"\n  Rapor kaydedildi: {txt_file}")

# ----------------------------------------------------------------------------
# 5.8 Özet
# ----------------------------------------------------------------------------

print("\n" + "=" * 70)
print("ADIM 5 TAMAMLANDI")
print("=" * 70)
print(f"""
Grafikler (Drive/results/figures):
  01_score_comparison.png
  02_p53_interface_contacts.png
  03_triad_validation.png

Rapor (Drive/results/interface_analysis):
  interface_analysis_report.txt

Triad doğrulaması: {sum(triad_results[p][2] for p in triad)}/3 residü interface'de
Sonraki adım: Mutasyon (kritik residüyü değiştir, etkileşim kaybını göster)
""")
