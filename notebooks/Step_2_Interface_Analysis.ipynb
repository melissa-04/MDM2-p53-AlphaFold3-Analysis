# ============================================================================
# 2.1 Interface Analiz Sınıfı
# ============================================================================

class InterfaceAnalyzer:
    """
    İki protein zinciri arasındaki etkileşim alanını analiz eder.
    
    Nedir?
    - İki proteinin birbirine temas eden bölgesine "interface" denir
    - Bu sınıf interface'deki amino asitleri ve kontaktları bulur
    """
    
    def __init__(self, pdb_file, chain1, chain2, distance_cutoff=5.0):
        """
        Parametreler:
        - pdb_file: Kompleks PDB dosyasının yolu
        - chain1: Birinci zincir (örn: 'A' = MDM2)
        - chain2: İkinci zincir (örn: 'B' = p53)
        - distance_cutoff: Kontakt mesafesi (Angstrom cinsinden)
        """
        self.parser = PDBParser(QUIET=True)
        self.structure = self.parser.get_structure('complex', pdb_file)
        self.chain1 = chain1
        self.chain2 = chain2
        self.distance_cutoff = distance_cutoff
        self.model = self.structure[0]
    
    def get_atoms_from_chain(self, chain_id):
        """
        Zincirdeki tüm atomları al.
        """
        atoms = []
        if chain_id in self.model:
            for residue in self.model[chain_id]:
                if residue.id[0] == ' ':  # Heteroatom değil
                    for atom in residue:
                        atoms.append({
                            'atom': atom,
                            'residue_id': residue.id[1],
                            'residue_name': residue.resname
                        })
        return atoms
    
    def find_interface_residues(self):
        """
        Chain1 ve Chain2 arasında kontakt olan residüeleri bul.
        
        Dönüş: İki zincirdeki interface residüeleri
        """
        interface_chain1 = {}  # residue_id -> residue_name
        interface_chain2 = {}
        
        atoms1 = self.get_atoms_from_chain(self.chain1)
        atoms2 = self.get_atoms_from_chain(self.chain2)
        
        # Chain1 ve Chain2 atomları arasında mesafe kontrol et
        for atom_data1 in atoms1:
            atom1 = atom_data1['atom']
            res_id1 = atom_data1['residue_id']
            res_name1 = atom_data1['residue_name']
            
            for atom_data2 in atoms2:
                atom2 = atom_data2['atom']
                res_id2 = atom_data2['residue_id']
                res_name2 = atom_data2['residue_name']
                
                # Mesafe hesapla (Angstrom)
                distance = atom1 - atom2
                
                if distance < self.distance_cutoff:
                    # Kontakt varsa kaydet
                    if res_id1 not in interface_chain1:
                        interface_chain1[res_id1] = res_name1
                    if res_id2 not in interface_chain2:
                        interface_chain2[res_id2] = res_name2
        
        return interface_chain1, interface_chain2
    
    def count_contacts(self):
        """
        Her residünün kaç atom kontaktı olduğunu say.
        """
        contact_counts = {}
        
        atoms1 = self.get_atoms_from_chain(self.chain1)
        atoms2 = self.get_atoms_from_chain(self.chain2)
        
        for atom_data1 in atoms1:
            atom1 = atom_data1['atom']
            res_id1 = atom_data1['residue_id']
            
            count = 0
            for atom_data2 in atoms2:
                atom2 = atom_data2['atom']
                distance = atom1 - atom2
                
                if distance < self.distance_cutoff:
                    count += 1
            
            if count > 0:
                if res_id1 not in contact_counts:
                    contact_counts[res_id1] = 0
                contact_counts[res_id1] += count
        
        return contact_counts
    
    def calculate_interface_score(self):
        """
        Interface kalitesini 0-100 arasında skor olarak hesapla.
        """
        interface1, interface2 = self.find_interface_residues()
        
        total_interface = len(interface1) + len(interface2)
        
        # Normalizasyon: ortalama protein ~350 residü
        # Interface ~25-30 residü varsa iyi etkileşim
        max_expected = 50
        score = min(100, (total_interface / max_expected) * 100)
        
        return {
            'interface_residues_chain1': interface1,
            'interface_residues_chain2': interface2,
            'total_interface_residues': total_interface,
            'interface_score': score
        }

