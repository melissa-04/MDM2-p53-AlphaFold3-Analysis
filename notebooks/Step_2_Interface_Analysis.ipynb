    print(f"\nMDM2'deki Interface Residüleri ({len(interface_data['interface_residues_chain1'])} adet):")
    chain1_interface = sorted(interface_data['interface_residues_chain1'].items())
    for res_id, res_name in chain1_interface[:15]:  # İlk 15'i göster
        print(f"  Residü {res_id}: {res_name}")
    
    print(f"\np53'teki Interface Residüleri ({len(interface_data['interface_residues_chain2'])} adet):")
    chain2_interface = sorted(interface_data['interface_residues_chain2'].items())
    for res_id, res_name in chain2_interface:
        print(f"  Residü {res_id}: {res_name}")
    
    print(f"\n{'='*70}")
    print(f"Toplam Interface Residüleri: {interface_data['total_interface_residues']}")
    print(f"Interface Skoru: {interface_data['interface_score']:.2f} / 100")
    print(f"{'='*70}")
    
    # Kritik residüleri bulma
    print("\nKritik Residüler (Bilinen Literatür):")
    print("-" * 70)
    print("p53'ün 'Triad' residüleri (MDM2'ye derinlemesine bağlanır):")
    critical_residues = {
        19: ('Phe', 'Phenylalanine - Hidrofobik'),
        23: ('Trp', 'Tryptophan - Hidrofobik, EN KRİTİK'),
        26: ('Leu', 'Leucine - Hidrofobik')
    }
    
    for res_id, (aa_code, description) in critical_residues.items():
        if res_id in interface_data['interface_residues_chain2']:
            status = "EVET - Interface'de"
        else:
            status = "HAYIR - Interface'de değil"
        print(f"  p53 Residü {res_id} ({aa_code}): {description} [{status}]")
    
    # Kontakt sayılarını hesapla
    print("\nEn Çok Kontakt Yapan Residüler:")
    print("-" * 70)
    contact_counts = analyzer.count_contacts()
    sorted_contacts = sorted(contact_counts.items(), key=lambda x: x[1], reverse=True)
    
    for res_id, count in sorted_contacts[:10]:
        if res_id in interface_data['interface_residues_chain1']:
            chain_info = "MDM2"
        else:
            chain_info = "p53"
        print(f"  Residü {res_id} ({chain_info}): {count} atom kontaktı")

