# ============================================================================
# 1.3 PDB dosyalarını indir
# ============================================================================

def download_pdb(pdb_id, save_dir):
    """
    RCSB PDB sunucusundan protein yapısını indir.
    
    Parametreler:
    - pdb_id: PDB kimlik numarası (örn: "1YCR")
    - save_dir: Kaydedilecek klasör yolu
    
    Dönüş: Indirilen dosyanın yolu
    """
    url = f"https://files.rcsb.org/download/{pdb_id}.pdb"
    filepath = os.path.join(save_dir, f"{pdb_id}.pdb")
    
    try:
        print(f"\nİndiriliyor: {pdb_id}...")
        response = requests.get(url, timeout=30)
        
        if response.status_code == 200:
            with open(filepath, 'w') as f:
                f.write(response.text)
            print(f"Başarılı: {filepath}")
            return filepath
        else:
            print(f"Hata: HTTP {response.status_code}")
            return None
            
    except Exception as e:
        print(f"İndirme hatası: {e}")
        return None

# PDB kimlik numaraları
PDB_ID = "1YCR"  # MDM2-p53 kompleksi (en iyi çalışılmış)

# İndir
protein_dir = f'{work_dir}/proteins'
pdb_file = download_pdb(PDB_ID, protein_dir)

if not pdb_file or not os.path.exists(pdb_file):
