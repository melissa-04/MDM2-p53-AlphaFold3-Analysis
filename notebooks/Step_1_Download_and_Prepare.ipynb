else:
    print(f"PDB dosyası hazır: {pdb_file}")

# ============================================================================
# 1.4 Protein yapısını analiz et
# ============================================================================

class ProteinStructure:
    """Protein yapısını okumak ve analiz etmek için sınıf."""
    
    def __init__(self, pdb_file):
        """
        PDB dosyasını yükle.
        
        Parametreler:
        - pdb_file: PDB dosyasının yolu
        """
        self.parser = PDBParser(QUIET=True)
        self.structure = self.parser.get_structure('protein', pdb_file)
        self.pdb_file = pdb_file
    
    def get_chain_info(self, chain_id):
        """
        Belirtilen zincirin bilgisini al.
        
        Parametreler:
        - chain_id: Zincir kimlik harfi (örn: "A", "B")
        
        Dönüş: Residü listesi
        """
        residues = []
        
        for model in self.structure:
            if chain_id in model:
                chain = model[chain_id]
                for residue in chain:
                    if residue.id[0] == ' ':  # Heteroatom değil
                        residues.append({
                            'id': residue.id[1],
                            'name': residue.resname,
                            'has_ca': 'CA' in residue
                        })
        
        return residues
    
    def get_chain_pdb(self, chain_id, output_file):
        """
        Belirtilen zinciri ayrı PDB dosyasına kaydet.
        
        Parametreler:
        - chain_id: Zincir kimlik harfi
        - output_file: Çıkış dosyasının yolu
        """
        class ChainSelector(Select):
            def __init__(self, chain_letter):
                self.chain_letter = chain_letter
            
            def accept_chain(self, chain):
                return chain.id == self.chain_letter
        
        io = PDBIO()
        io.set_structure(self.structure)
        io.save(output_file, ChainSelector(chain_id))
        print(f"Zincir {chain_id} kaydedildi: {output_file}")

