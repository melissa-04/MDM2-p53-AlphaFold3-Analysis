# ----------------------------------------------------------------------------
# 7.2 Her iki kompleksin rank_001 skorlarını çıkar
# ----------------------------------------------------------------------------

def get_scores(folder_pattern):
    files = glob.glob(f'{af_dir}/{folder_pattern}/**/*scores_rank_001*.json', recursive=True)
    with open(files[0]) as f:
        data = json.load(f)
    return {
        'plddt': float(np.mean(data['plddt'])),
        'ptm': float(data.get('ptm', 0)),
        'iptm': float(data.get('iptm', 0))
    }

wt = get_scores('mdm2_p53_complex')
mut = get_scores('mdm2_p53_W23A_complex')

print("\n" + "=" * 70)
print("SKOR KARŞILAŞTIRMASI")
print("=" * 70)
print(f"\n{'Metrik':<12}{'Wild-type':>12}{'W23A Mutant':>14}{'Değişim':>12}")
print("-" * 50)
for key, name in [('plddt','pLDDT'), ('ptm','pTM'), ('iptm','ipTM')]:
    diff = mut[key] - wt[key]
    arrow = "DÜŞTÜ" if diff < -0.02 else ("arttı" if diff > 0.02 else "~aynı")
    if key == 'plddt':
        print(f"{name:<12}{wt[key]:>12.1f}{mut[key]:>14.1f}{diff:>+10.1f}  {arrow}")
    else:
        print(f"{name:<12}{wt[key]:>12.3f}{mut[key]:>14.3f}{diff:>+10.3f}  {arrow}")

# ----------------------------------------------------------------------------
# 7.3 Her iki kompleksin interface büyüklüğünü hesapla
# ----------------------------------------------------------------------------

def count_interface(folder_pattern, cutoff=5.0):
    pdbs = glob.glob(f'{af_dir}/{folder_pattern}/**/*unrelaxed_rank_001*.pdb', recursive=True)
    parser = PDBParser(QUIET=True)
    model = parser.get_structure('c', pdbs[0])[0]
    
    def atoms(cid):
        out = []
        if cid in model:
            for res in model[cid]:
                if res.id[0] == ' ':
                    for a in res:
                        out.append((a, res.id[1]))
        return out
    
    A, B = atoms('A'), atoms('B')
    iface_A, iface_B = set(), set()
    for a, ra in A:
        for b, rb in B:
            if a - b < cutoff:
                iface_A.add(ra); iface_B.add(rb)
    return len(iface_A), len(iface_B)

wt_ifA, wt_ifB = count_interface('mdm2_p53_complex')
mut_ifA, mut_ifB = count_interface('mdm2_p53_W23A_complex')

print("\n" + "=" * 70)
print("INTERFACE BÜYÜKLÜĞÜ KARŞILAŞTIRMASI")
print("=" * 70)
