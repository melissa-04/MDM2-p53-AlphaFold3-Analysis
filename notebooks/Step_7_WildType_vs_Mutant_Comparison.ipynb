b2 = ax2.bar(x + w/2, [wt_ifB, mut_ifB], w, label='p53 tarafı', color='#ff7f0e', edgecolor='black')
ax2.set_xticks(x)
ax2.set_xticklabels(groups)
ax2.set_ylabel('Interface residü sayısı')
ax2.set_title('Interface Büyüklüğü: Wild-type vs W23A', fontweight='bold')
ax2.legend()
for bars_set in [b1, b2]:
    for bar in bars_set:
        h = bar.get_height()
        ax2.text(bar.get_x()+bar.get_width()/2, h+0.3, f'{int(h)}',
                 ha='center', fontweight='bold')

