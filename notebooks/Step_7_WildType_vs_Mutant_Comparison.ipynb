ax1.legend()
for bar, v in zip(bars, iptm_vals):
    ax1.text(bar.get_x()+bar.get_width()/2, v+0.02, f'{v:.3f}',
             ha='center', fontweight='bold', fontsize=12)

# Düşüş okunu ekle
if mut['iptm'] < wt['iptm']:
    pct = (wt['iptm'] - mut['iptm']) / wt['iptm'] * 100
    ax1.annotate(f'%{pct:.0f} düşüş',
                 xy=(1, mut['iptm']), xytext=(0.5, (wt['iptm']+mut['iptm'])/2),
                 fontsize=11, fontweight='bold', color='darkred',
                 ha='center')

# Panel 2: interface büyüklüğü
