work_dir = '/content/drive/My Drive/MDM2_p53_Project'
af_dir   = f'{work_dir}/results/alphafold_predictions'
os.makedirs(af_dir, exist_ok=True)

print("Çalışma klasörü:", work_dir)

# ----------------------------------------------------------------------------
# 4.2 ZIP dosyalarını bul ve aç
# ----------------------------------------------------------------------------

import zipfile
import glob

print("\n" + "=" * 70)
print("ZIP DOSYALARI AÇILIYOR")
print("=" * 70)

# Ana klasördeki tüm .result.zip dosyalarını bul
zip_files = glob.glob(f'{work_dir}/*.result.zip')

print(f"\nBulunan ZIP dosyaları: {len(zip_files)}")
for z in zip_files:
    print(f"  {os.path.basename(z)}")

# Her ZIP'i kendi klasörüne aç
def get_clean_name(zip_path):
    """Dosya adından temiz etiket çıkar (mdm2_p53_complex_bcb94 -> mdm2_p53_complex)"""
    base = os.path.basename(zip_path).replace('.result.zip', '')
    # Sondaki rastgele ek (_bcb94 gibi) at
    parts = base.rsplit('_', 1)
    return parts[0] if len(parts) == 2 else base

extracted_dirs = {}

for zip_path in zip_files:
    clean_name = get_clean_name(zip_path)
    out_dir = f'{af_dir}/{clean_name}'
    os.makedirs(out_dir, exist_ok=True)
    
    with zipfile.ZipFile(zip_path, 'r') as zf:
        zf.extractall(out_dir)
    
    extracted_dirs[clean_name] = out_dir
    file_count = len(os.listdir(out_dir))
    print(f"\n  Açıldı: {clean_name} ({file_count} dosya)")

# ----------------------------------------------------------------------------
# 4.3 Her tahminin içindeki dosyaları incele
# ----------------------------------------------------------------------------

print("\n" + "=" * 70)
print("DOSYA İÇERİKLERİ")
print("=" * 70)

for name, d in extracted_dirs.items():
    print(f"\n{name}:")
    files = sorted(os.listdir(d))
    for f in files:
        print(f"  {f}")

# ----------------------------------------------------------------------------
# 4.4 Skorları çıkar (pLDDT, pTM, ipTM)
# ----------------------------------------------------------------------------

import json
import numpy as np

print("\n" + "=" * 70)
print("SKORLAR ÇIKARILIYOR")
print("=" * 70)

def extract_scores(pred_dir):
    """ColabFold çıktısından rank_001 skorlarını çıkar."""
    # rank_001 (en iyi model) JSON dosyasını bul
    score_files = glob.glob(f'{pred_dir}/*rank_001*.json')
    # scores dosyasını ayıkla (PAE içeren ana dosya)
    score_files = [f for f in score_files if 'scores' in f.lower() 
                   or 'rank_001' in f]
    
    if not score_files:
        return None
    
    # En uygun dosyayı seç
    target = None
    for f in score_files:
        with open(f) as fh:
            try:
                data = json.load(fh)
                if 'plddt' in data:
                    target = data
                    break
            except:
                continue
    
    if not target:
        return None
    
    result = {}
    if 'plddt' in target:
        result['plddt_mean'] = float(np.mean(target['plddt']))
        result['plddt_min'] = float(np.min(target['plddt']))
        result['plddt_max'] = float(np.max(target['plddt']))
    if 'ptm' in target:
        result['ptm'] = float(target['ptm'])
    if 'iptm' in target:
        result['iptm'] = float(target['iptm'])
    
    return result

all_scores = {}

for name, d in extracted_dirs.items():
    scores = extract_scores(d)
    all_scores[name] = scores
    
    print(f"\n{name}:")
    if scores:
        print(f"  pLDDT (ortalama): {scores.get('plddt_mean', 'N/A'):.2f}")
        print(f"  pLDDT (aralık): {scores.get('plddt_min', 0):.1f} - {scores.get('plddt_max', 0):.1f}")
        if 'ptm' in scores:
            print(f"  pTM: {scores['ptm']:.3f}")
        if 'iptm' in scores:
            print(f"  ipTM: {scores['iptm']:.3f}  (etkileşim güveni)")
    else:
        print("  Skor bulunamadı")

# ----------------------------------------------------------------------------
# 4.5 Skorları dosyaya kaydet
# ----------------------------------------------------------------------------

scores_file = f'{af_dir}/extracted_scores.txt'

with open(scores_file, 'w') as f:
    f.write("AlphaFold2 Tahmin Skorları - MDM2-p53\n")
    f.write("=" * 70 + "\n\n")
    
    for name, scores in all_scores.items():
        f.write(f"{name}\n")
        f.write("-" * 70 + "\n")
        if scores:
            f.write(f"  pLDDT (mean): {scores.get('plddt_mean', 0):.2f}\n")
            f.write(f"  pLDDT (range): {scores.get('plddt_min', 0):.1f} - {scores.get('plddt_max', 0):.1f}\n")
            if 'ptm' in scores:
                f.write(f"  pTM: {scores['ptm']:.3f}\n")
            if 'iptm' in scores:
                f.write(f"  ipTM: {scores['iptm']:.3f}\n")
        f.write("\n")

print(f"\n\nSkorlar kaydedildi: {scores_file}")

print("\n" + "=" * 70)
print("ADIM 4 TAMAMLANDI")
