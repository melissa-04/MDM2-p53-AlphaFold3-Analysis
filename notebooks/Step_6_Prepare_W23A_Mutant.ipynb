# ============================================================================
# ADIM 6: Mutant (W23A) Sekansını Hazırla
# p53'ün 23. pozisyonundaki Trp -> Ala mutasyonu
# ============================================================================

import os

work_dir = '/content/drive/My Drive/MDM2_p53_Project'
seq_dir  = f'{work_dir}/proteins/sequences'
mut_dir  = f'{work_dir}/proteins/mutant'
os.makedirs(mut_dir, exist_ok=True)

print("=" * 70)
print("ADIM 6: W23A MUTASYONU HAZIRLANIYOR")
print("=" * 70)

# ----------------------------------------------------------------------------
# 6.1 Wild-type sekansları
# ----------------------------------------------------------------------------

mdm2_seq = "MCNTNMSVPTDGAVTTSQIPASEQETLVRPKPLLLKLLKSVGAQKDTYTMKEVLFYLGQYIMTKRLYDEKQQHIVYCSNDLLGDLFGVPSFSVKEHRKIYTMIYRNLVVVNQQESSDSGTSVSEN"
p53_wt   = "MEEPQSDPSVEPPLSQETFSDLWKLLPENNVLSPLPSQAMDDLMLSPDDIEQWFTEDPGPDEAPRMPEAAPPV"

# ----------------------------------------------------------------------------
# 6.2 Mutasyonu yap: pozisyon 23 (1-tabanlı) -> Python'da index 22
# ----------------------------------------------------------------------------

pos = 23  # biyolojik pozisyon (1'den başlar)
idx = pos - 1

original_aa = p53_wt[idx]
print(f"\np53 pozisyon {pos}: {original_aa}")

# Doğrulama: gerçekten W (Trp) mi?
if original_aa != 'W':
    print(f"UYARI: Pozisyon {pos}'de beklenen W değil, {original_aa} bulundu!")
else:
    print("Doğrulandı: pozisyon 23 = W (Trp). Mutasyon yapılıyor...")

# W -> A değişimi
p53_mut = p53_wt[:idx] + 'A' + p53_wt[idx+1:]

print(f"\nWild-type p53 (23. pozisyon çevresi): ...{p53_wt[idx-3:idx+4]}...")
print(f"Mutant   p53 (23. pozisyon çevresi): ...{p53_mut[idx-3:idx+4]}...")
print(f"\nDeğişim: {original_aa}23A  (Trp -> Ala)")

# Sekansların aynı uzunlukta olduğunu kontrol et (yapı bütünlüğü)
assert len(p53_wt) == len(p53_mut), "Uzunluk değişti - hata!"
print(f"Uzunluk korundu: {len(p53_mut)} aa (sadece 1 residü değişti)")

# ----------------------------------------------------------------------------
# 6.3 Mutant kompleks FASTA'sını kaydet
# ----------------------------------------------------------------------------

# ColabFold için: mdm2 : p53_mutant (iki nokta ile ayrılmış kompleks)
complex_mut_fasta = f'{mut_dir}/mdm2_p53_W23A_complex.fasta'
with open(complex_mut_fasta, 'w') as f:
    f.write(f">mdm2_p53_W23A\n{mdm2_seq}:{p53_mut}\n")

# Referans için mutant p53 tek başına da kaydet
p53_mut_fasta = f'{mut_dir}/p53_W23A.fasta'
with open(p53_mut_fasta, 'w') as f:
    f.write(f">p53_W23A\n{p53_mut}\n")

print(f"\nKaydedildi:")
print(f"  {complex_mut_fasta}")
print(f"  {p53_mut_fasta}")

# ----------------------------------------------------------------------------
# 6.4 ColabFold'a yapıştırılacak sekansı ekrana yaz
# ----------------------------------------------------------------------------

print("\n" + "=" * 70)
print("COLABFOLD'A YAPIŞTIRILACAK MUTANT KOMPLEKS SEKANSI")
print("=" * 70)
print("\nquery_sequence kutusuna (tek satır, ortada : var):\n")
print(f"{mdm2_seq}:{p53_mut}")
print(f"\njobname kutusuna:\n")
print("mdm2_p53_W23A_complex")

print("\n" + "=" * 70)
print("ADIM 6 TAMAMLANDI")
print("=" * 70)
